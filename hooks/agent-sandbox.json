{
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["gh", "gh *", "${CLAUDE_PLUGIN_ROOT}/skills/research/scripts/gcp-skus.sh *", "${CLAUDE_PLUGIN_ROOT}/skills/research/scripts/reddit-search.sh *", "${CLAUDE_PLUGIN_ROOT}/skills/research/scripts/repo-health.sh *"],
    "network": {
      "strictAllowlist": true,
      "allowedDomains": ["api.github.com", "github.com", "raw.githubusercontent.com", "codeload.github.com", "hn.algolia.com", "export.arxiv.org", "arxiv.org", "b0.p.awsstatic.com", "pricing.us-east-1.amazonaws.com", "cloudbilling.googleapis.com", "www.reddit.com", "oauth.reddit.com"]
    },
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.aws", "~/.kube", "~/.gnupg", "~/.docker", "~/.azure", "~/.netrc", "~/.git-credentials", "~/.npmrc", "~/.pypirc", "~/.config", "~/.claude.json", "~/.claude/.credentials.json", "~/.zsh_history", "~/.bash_history", "~/Library/Keychains", "~/Library/Application Support/Google/Chrome", "~/Library/Cookies",
                 "~/.claude/backups", "~/.claude/remote-settings.json", "~/.claude/remote-settings-consent.json",
                 "~/.claude/history.jsonl", "~/.claude/file-history", "~/.claude/sessions", "~/.claude/session-env", "~/.claude/shell-snapshots", "~/.claude/paste-cache", "~/.claude", "~/.cache/agent-runs"],
      "allowRead": ["${CLAUDE_PLUGIN_ROOT}"],
      "denyWrite": ["~/.claude", "~/notes", "~/code"]
    },
    "credentials": {
      "envVars": [
        {"name": "CLAUDE_CODE_MESSAGING_TOKEN", "mode": "deny"},
        {"name": "ANTHROPIC_API_KEY", "mode": "deny"},
        {"name": "ANTHROPIC_AUTH_TOKEN", "mode": "deny"},
        {"name": "CLAUDE_CODE_OAUTH_TOKEN", "mode": "deny"},
        {"name": "GH_TOKEN", "mode": "deny"},
        {"name": "GITHUB_TOKEN", "mode": "deny"},
        {"name": "TFE_TOKEN", "mode": "deny"},
        {"name": "AWS_ACCESS_KEY_ID", "mode": "deny"},
        {"name": "AWS_SECRET_ACCESS_KEY", "mode": "deny"},
        {"name": "AWS_SESSION_TOKEN", "mode": "deny"}
      ]
    }
  },
  "permissions": {
    "deny": ["Read(~/.ssh/**)", "Read(~/.aws/**)", "Read(~/.kube/**)", "Read(~/.gnupg/**)", "Read(~/.docker/**)", "Read(~/.netrc)", "Read(~/.git-credentials)", "Read(~/.azure/**)", "Read(~/.npmrc)", "Read(~/.pypirc)", "Read(~/.config/**)", "Read(~/.claude.json)", "Read(~/.claude/.credentials.json)",
             "Read(~/.zsh_history)", "Read(~/.bash_history)", "Read(~/Library/Keychains/**)", "Read(~/Library/Cookies/**)", "Read(~/Library/Application Support/Google/Chrome/**)",
             "Read(~/.claude/backups/**)", "Read(~/.claude/remote-settings.json)", "Read(~/.claude/remote-settings-consent.json)",
             "Read(~/.claude/history.jsonl)", "Read(~/.claude/file-history/**)", "Read(~/.claude/sessions/**)", "Read(~/.claude/session-env/**)", "Read(~/.claude/shell-snapshots/**)", "Read(~/.claude/paste-cache/**)", "Read(~/.cache/agent-runs/**)"]
  }
}
